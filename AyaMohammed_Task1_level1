    "# تحويل عمود التاريخ إلى صيغة تاريخ (Datetime) واستخراج الشهر\n",
    "df['Date'] = pd.to_datetime(df['Date'])\n",
    "df['Month'] = df['Date'].dt.to_period('M')\n",
    "\n",
    "# تجميع المبيعات حسب الشهر\n",
    "monthly_sales = df.groupby('Month')['Total Amount'].sum().reset_index()\n",
    "monthly_sales['Month'] = monthly_sales['Month'].astype(str)\n",
    "\n",
    "# رسم خط زمني يوضح تطور المبيعات\n",
    "plt.figure(figsize=(10, 4))\n",
    "sns.lineplot(data=monthly_sales, x='Month', y='Total Amount', marker='o', color='b', linewidth=2)\n",
    "plt.title('Sales Trend Over Time (Monthly)')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Total Sales Amount')\n",
    "plt.xticks(rotation=45)\n",
    "plt.grid(True, linestyle='--', alpha=0.6)\n",
    "plt.show()"
   ]
